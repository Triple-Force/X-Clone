<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="500.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-padding: 20;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.ImageUploadDialogController">
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="Attach Images" textFill="#0f1419">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <Button onAction="#handleChooseImages" style="-fx-background-color: #eff3f4; -fx-text-fill: #0f1419; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 16 8 16; -fx-cursor: hand;" text=" Choose Images..." />
        
        <ScrollPane fitToHeight="true" prefHeight="140.0" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: #eff3f4; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
            <content>
                <HBox fx:id="imagePreviewContainer" alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10;" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #536471; -fx-font-weight: bold; -fx-cursor: hand;" text="Cancel" />
                <Button onAction="#handleConfirm" style="-fx-background-color: #1d9bf0; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-cursor: hand;" text="Done" />
            </children>
        </HBox>
    </children>
</VBox>
