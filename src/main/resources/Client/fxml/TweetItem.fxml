<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox maxWidth="1.7976931348623157E308" style="-fx-border-color: #eff3f4; -fx-border-width: 0 0 1 0; -fx-padding: 15; -fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.TweetItemController">
    <children>
        <VBox prefWidth="50.0">
            <children>
                <ImageView fx:id="avatarImageView" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 20;" />
            </children>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <Label fx:id="displayNameLabel" text="USERNAME" textFill="#0f1419">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                        <Label fx:id="usernameLabel" text="ID" textFill="#536471" />
                        <Label text="•" textFill="#536471" />
                        <Label fx:id="dateLabel" text="TIME" textFill="#536471" />
                    </children>
                </HBox>

                <Label fx:id="tweetTextLabel" maxWidth="1.7976931348623157E308" text="TWEET" textFill="#0f1419" wrapText="true">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>

                <HBox spacing="60.0" style="-fx-padding: 5 0 0 0;">
                    <children>
                        <Button fx:id="commentButton" style="-fx-background-color: transparent; -fx-text-fill: #536471;" text="💬 0" />
                        <Button fx:id="retweetButton" style="-fx-background-color: transparent; -fx-text-fill: #536471;" text="🔁 0" />
                        <Button fx:id="likeButton" style="-fx-background-color: transparent; -fx-text-fill: #536471;" text="👍0" />
                    </children>
                </HBox>
            </children>
            <HBox.margin>
                <Insets left="10.0" />
            </HBox.margin>
        </VBox>
    </children>
</HBox>
