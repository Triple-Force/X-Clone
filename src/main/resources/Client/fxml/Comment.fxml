<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="520.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-padding: 20;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.CommentController">
    <children>
        <Label text="Reply to Tweet" textFill="#0f1419">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <HBox spacing="10.0" style="-fx-padding: 0 0 10 0; -fx-border-color: #eff3f4; -fx-border-width: 0 0 1 0;">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <Label fx:id="targetDisplayNameLabel" text="User Name" textFill="#0f1419">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="targetUsernameLabel" text="\@username" textFill="#536471" />
                            </children>
                        </HBox>
                        <Label fx:id="targetTweetTextLabel" text="Original tweet text preview..." textFill="#0f1419" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <TextArea fx:id="commentTextArea" prefRowCount="3" promptText="Post your reply..." style="-fx-background-color: transparent; -fx-border-color: #cfd9de; -fx-border-radius: 10; -fx-padding: 5;" wrapText="true">
            <font>
                <Font size="15.0" />
            </font>
        </TextArea>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #0f1419; -fx-font-weight: bold; -fx-cursor: hand;" text="Cancel" />
                <Button onAction="#handleSubmitComment" style="-fx-background-color: #1d9bf0; -fx-text-fill: #ffffff; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-cursor: hand;" text="Reply" />
            </children>
        </HBox>
    </children>
</VBox>