<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="480.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.EditProfileController">
    <children>

        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #eff3f4; -fx-border-width: 0 0 1 0; -fx-padding: 15 20 15 20;">
            <children>
                <Label text="Edit Profile" HBox.hgrow="ALWAYS">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Pane HBox.hgrow="ALWAYS" />
                <Button fx:id="closeButton" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #536471; -fx-font-weight: bold; -fx-cursor: hand;" text="✕" />
            </children>
        </HBox>

        <VBox spacing="15.0" style="-fx-padding: 0 20 20 20;">
            <children>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <ImageView fx:id="avatarPreview" fitHeight="70.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 35; -fx-border-color: #eff3f4; -fx-border-width: 2; -fx-border-radius: 35;" />
                        <Button fx:id="changeAvatarButton" onAction="#handleChangeAvatar" style="-fx-background-color: #eff3f4; -fx-text-fill: #0f1419; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-cursor: hand;" text="Change Photo" />
                    </children>
                </HBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Display Name" textFill="#536471">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="displayNameField" promptText="Enter your name" style="-fx-background-color: #ffffff; -fx-border-color: #cfd9de; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Username" textFill="#536471">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="usernameField" promptText="Enter username" style="-fx-background-color: #ffffff; -fx-border-color: #cfd9de; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Bio" textFill="#536471">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextArea fx:id="bioTextArea" prefRowCount="3" promptText="Describe yourself..." style="-fx-background-color: #ffffff; -fx-border-color: #cfd9de; -fx-border-radius: 8; -fx-background-radius: 8;" wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button fx:id="cancelButton" onAction="#handleCancel" style="-fx-background-color: #eff3f4; -fx-text-fill: #0f1419; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-cursor: hand;" text="Cancel" />
                        <Button fx:id="saveButton" onAction="#handleSave" style="-fx-background-color: #1d9bf0; -fx-text-fill: #ffffff; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 8 25 8 25; -fx-cursor: hand;" text="Save" />
                    </children>
                </HBox>

            </children>
        </VBox>

    </children>
</VBox>