<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="450.0" style="-fx-background-color: #f7f9fa;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.ProfileController">
    <children>

        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #ffffff; -fx-border-color: #eff3f4; -fx-border-width: 0 0 1 0; -fx-padding: 10 20 10 20;">
            <children>
                <VBox>
                    <children>
                        <Label fx:id="headerNameLabel" text="Profile">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f7f9fa;" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="15.0" style="-fx-padding: 15;">
                    <children>

                        <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <children>

                                <Pane prefHeight="160.0" style="-fx-background-color: linear-gradient(to right, #1d9bf0, #002244); -fx-background-radius: 15 15 0 0;" />

                                <HBox alignment="BOTTOM_RIGHT" prefHeight="90.0" style="-fx-padding: 0 20 10 20;">
                                    <children>
                                        <Pane HBox.hgrow="ALWAYS">
                                            <children>
                                                <ImageView fx:id="profileAvatar" fitHeight="100.0" fitWidth="100.0" layoutY="-50.0" pickOnBounds="true" preserveRatio="false">
                                                    <clip>
                                                        <Circle centerX="50.0" centerY="50.0" radius="50.0" />
                                                    </clip>
                                                </ImageView>
                                            </children>
                                        </Pane>
                                        <Button fx:id="editProfileButton" onAction="#handleEditProfile" style="-fx-background-color: #0f1419; -fx-text-fill: #ffffff; -fx-background-radius: 25; -fx-font-weight: bold; -fx-padding: 10 20 10 20; -fx-cursor: hand;" text="Edit Profile" />
                                    </children>
                                </HBox>

                                <VBox spacing="8.0" style="-fx-padding: 10 20 20 20;">
                                    <children>
                                        <Label fx:id="displayNameLabel" text="Name">
                                            <font>
                                                <Font name="System Bold" size="24.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="usernameLabel" text="@username" textFill="#536471">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>

                                        <Label fx:id="bioLabel" text="User bio goes here..." textFill="#0f1419" wrapText="true">
                                            <font>
                                                <Font size="15.0" />
                                            </font>
                                            <VBox.margin>
                                                <Insets bottom="5.0" top="5.0" />
                                            </VBox.margin>
                                        </Label>

                                        <HBox spacing="20.0" style="-fx-padding: 5 0 0 0;">
                                            <children>
                                                <HBox onMouseClicked="#handleShowFollowing" spacing="5.0" style="-fx-cursor: hand;">
                                                    <children>
                                                        <Label fx:id="followingCountLabel" style="-fx-font-weight: bold; -fx-text-fill: #0f1419;" text="0" />
                                                        <Label text="Following" textFill="#536471" />
                                                    </children>
                                                </HBox>

                                                <HBox onMouseClicked="#handleShowFollowers" spacing="5.0" style="-fx-cursor: hand;">
                                                    <children>
                                                        <Label fx:id="followersCountLabel" style="-fx-font-weight: bold; -fx-text-fill: #0f1419;" text="0" />
                                                        <Label text="Followers" textFill="#536471" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>

                        <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <children>
                                <Label maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #0f1419; -fx-padding: 0 0 10 0; -fx-border-color: #eff3f4; -fx-border-width: 0 0 1 0;" text="Posts" />
                                <VBox fx:id="userTweetsContainer" spacing="10.0" style="-fx-padding: 15 0 0 0;">
                                    <children>
                                        <Label text="You haven't posted anything yet." textFill="#666666" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>