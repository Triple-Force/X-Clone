<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: linear-gradient(to bottom, #fcf2e2 0%, #ffffff 100%);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.ForgotPasswordController">
    <children>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="420.0" spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 25, 0.5, 0, 10); -fx-padding: 35 35 35 35;">
            <children>
                <ImageView fx:id="logoImageView" fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/x-logo-1.png" />
                    </image>
                </ImageView>

                <Label text="Forgot password?" textFill="#111111">
                    <font>
                        <Font name="System Bold" size="26.0" />
                    </font>
                </Label>

                <Label alignment="CENTER" prefWidth="310.0" text="Enter your email address and we'll send you a code to reset your password." textAlignment="CENTER" textFill="#666666" wrapText="true">
                    <font>
                        <Font size="13.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="2.0" top="-5.0" />
                    </VBox.margin>
                </Label>

                <HBox alignment="CENTER_LEFT" prefHeight="45.0" prefWidth="310.0" style="-fx-border-color: #e0e0e0; -fx-border-radius: 25; -fx-background-radius: 25; -fx-background-color: #fafafa; -fx-padding: 0 15 0 15;">
                    <children>
                        <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true" style="-fx-opacity: 0.6;">
                            <image>
                                <Image url="@../images/email.png" />
                            </image>
                        </ImageView>
                        <TextField fx:id="emailField" prefHeight="40.0" promptText="Email Address" style="-fx-background-color: transparent; -fx-padding: 5 10 5 10;" HBox.hgrow="ALWAYS">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>
                    </children>
                </HBox>

                <Label fx:id="errorLabel" alignment="CENTER" managed="false" maxWidth="350.0" textFill="#e53935" visible="false" wrapText="true">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <Button fx:id="resetButton" defaultButton="true" mnemonicParsing="false" onAction="#handleResetPassword" prefWidth="350.0" style="-fx-background-color: #28cf69; -fx-text-fill: white; -fx-background-radius: 25; -fx-border-radius: 25; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 12; -fx-cursor: hand;" text="Send Reset Code" />

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Hyperlink fx:id="backToLoginLink" alignment="CENTER" onAction="#handleBackToLogin" styleClass="sign-up-link" stylesheets="@../css/style.css" text="Back to Log in" />
                    </children>
                    <VBox.margin>
                        <Insets top="2.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
