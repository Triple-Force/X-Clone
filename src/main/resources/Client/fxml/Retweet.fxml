<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="500.0" spacing="12.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controllers.RetweetController">
    <children>
        <Label text="Quote Tweet" textFill="#0f1419">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <TextArea fx:id="quoteTextArea" prefRowCount="3" promptText="Add a comment..." style="-fx-background-color: transparent; -fx-border-color: #cfd9de; -fx-border-radius: 8;" wrapText="true" />

        <VBox fx:id="originalTweetContainer" style="-fx-border-color: #cfd9de; -fx-border-radius: 10; -fx-padding: 10; -fx-background-color: #f7f9fa;">
            <children>
                <Label fx:id="originalAuthorLabel" style="-fx-font-weight: bold;" text="@username" textFill="#0f1419" />
                <Label fx:id="originalTextLabel" text="Original tweet content goes here..." textFill="#536471" wrapText="true" />
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #536471; -fx-cursor: hand;" text="Cancel" />
                <Button onAction="#handleRetweetSubmit" style="-fx-background-color: #1d9bf0; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 6 16 6 16; -fx-cursor: hand;" text="Retweet" />
            </children>
        </HBox>
    </children>
</VBox>